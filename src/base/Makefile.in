YdlLexer.ll : YdlParser.yy
YdlParser.hh : YdlParser.yy

YdlLexer.cc : YdlLexer.ll
	$(LEX) -t YdlLexer.ll > YdlLexer.cc

YdlParser.cc : YdlParser.yy
	$(YACC) -d YdlParser.yy
	mv y.tab.c YdlParser.cc
	mv y.tab.h YdlParser.hh

